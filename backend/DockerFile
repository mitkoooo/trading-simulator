FROM ghcr.io/astral-sh/uv:python3.12-bookworm AS build
WORKDIR /app

# Copy metadata first for layer caching
COPY pyproject.toml uv.lock* ./
RUN uv sync --no-dev --frozen  # install deps into /usr/local

# Now copy source
COPY . .

EXPOSE 8000
ENV PYTHONUNBUFFERED=1 UV_LINK_MODE=copy
CMD ["uv", "run", "uvicorn", "app.server:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
